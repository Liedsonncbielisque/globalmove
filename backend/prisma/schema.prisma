generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  name          String
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  profile       UserProfile?
  financialProfile FinancialProfile?
  favorites     Favorite[]
  goals         Goal[]
  simulations   Simulation[]
  
  @@map("users")
}

model UserProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  age                   Int
  nationality           String
  profession            String
  education             String
  yearsExperience       Int      @map("years_experience")
  englishLevel          String   @map("english_level")
  otherLanguages        String[] @map("other_languages")
  maritalStatus         String   @map("marital_status")
  adults                Int      @default(1)
  children              Int      @default(0)
  dependents            Int      @default(0)
  objective             String
  targetTimeline        Int      @map("target_timeline")
  preferredCurrency     String   @default("BRL") @map("preferred_currency")
  
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_profiles")
}

model FinancialProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  currentCapital    Decimal  @map("current_capital") @db.Decimal(15, 2)
  monthlyIncome     Decimal  @map("monthly_income") @db.Decimal(15, 2)
  partnerIncome     Decimal? @map("partner_income") @db.Decimal(15, 2)
  monthlySavings    Decimal  @map("monthly_savings") @db.Decimal(15, 2)
  debts             Decimal  @default(0) @db.Decimal(15, 2)
  fixedExpenses     Decimal  @map("fixed_expenses") @db.Decimal(15, 2)
  variableExpenses  Decimal  @map("variable_expenses") @db.Decimal(15, 2)
  assets            Decimal  @default(0) @db.Decimal(15, 2)
  currency          String   @default("BRL")
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("financial_profiles")
}

model Country {
  id              String   @id @default(uuid())
  name            String
  officialName    String   @map("official_name")
  isoCode         String   @unique @map("iso_code")
  iso3            String   @unique
  flag            String
  continent       String
  region          String
  currency        String
  language        String
  population      BigInt
  capital         String
  timezone        String
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  cities          City[]
  visaRoutes      VisaRoute[]
  costOfLiving    CostOfLiving[]
  rentData        RentData[]
  
  @@map("countries")
}

model City {
  id                  String   @id @default(uuid())
  countryId           String   @map("country_id")
  name                String
  population          BigInt
  latitude            Decimal  @db.Decimal(10, 7)
  longitude           Decimal  @db.Decimal(10, 7)
  airport             String?
  costIndex           Decimal? @map("cost_index") @db.Decimal(5, 2)
  qualityOfLifeScore  Decimal? @map("quality_of_life_score") @db.Decimal(5, 2)
  safetyScore         Decimal? @map("safety_score") @db.Decimal(5, 2)
  employmentScore     Decimal? @map("employment_score") @db.Decimal(5, 2)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  
  country             Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  rentData            RentData[]
  
  @@map("cities")
}

model CostOfLiving {
  id              String   @id @default(uuid())
  countryId       String   @map("country_id")
  cityId          String?  @map("city_id")
  category        String
  rent            Decimal  @db.Decimal(10, 2)
  food            Decimal  @db.Decimal(10, 2)
  transport       Decimal  @db.Decimal(10, 2)
  utilities       Decimal  @db.Decimal(10, 2)
  internet        Decimal  @db.Decimal(10, 2)
  health          Decimal  @db.Decimal(10, 2)
  leisure         Decimal  @db.Decimal(10, 2)
  averageSalary   Decimal? @map("average_salary") @db.Decimal(10, 2)
  currency        String
  source          String
  sourceUrl       String?  @map("source_url")
  confidence      String
  retrievedAt     DateTime @map("retrieved_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  country         Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  
  @@map("cost_of_living")
}

model RentData {
  id             String   @id @default(uuid())
  countryId      String   @map("country_id")
  cityId         String?  @map("city_id")
  propertyType   String   @map("property_type")
  bedrooms       Int
  neighborhood   String?
  averagePrice   Decimal  @map("average_price") @db.Decimal(10, 2)
  currency       String
  source         String
  sourceUrl      String?  @map("source_url")
  confidence     String
  retrievedAt    DateTime @map("retrieved_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  country        Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  city           City?    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  
  @@map("rent_data")
}

model VisaRoute {
  id                        String   @id @default(uuid())
  countryId                 String   @map("country_id")
  name                      String
  category                  String
  description               String   @db.Text
  minIncome                 Decimal? @map("min_income") @db.Decimal(15, 2)
  minInvestment             Decimal? @map("min_investment") @db.Decimal(15, 2)
  minAge                    Int?     @map("min_age")
  maxAge                    Int?     @map("max_age")
  languageRequirement       String?  @map("language_requirement")
  educationRequirement      String?  @map("education_requirement")
  experienceRequirement     Int?     @map("experience_requirement")
  requiredDocuments         String[] @map("required_documents")
  fee                       Decimal? @db.Decimal(10, 2)
  feeCurrency               String?  @map("fee_currency")
  processingTime            String?  @map("processing_time")
  duration                  String?
  renewable                 Boolean  @default(false)
  allowsPermanentResidence  Boolean  @default(false) @map("allows_permanent_residence")
  allowsCitizenship         Boolean  @default(false) @map("allows_citizenship")
  officialSource            String   @map("official_source")
  officialUrl               String   @map("official_url")
  lastVerified              DateTime @map("last_verified")
  isActive                  Boolean  @default(true) @map("is_active")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  
  country                   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  
  @@map("visa_routes")
}

model ExchangeRate {
  id          String   @id @default(uuid())
  fromCurrency String  @map("from_currency")
  toCurrency   String  @map("to_currency")
  rate         Decimal @db.Decimal(15, 6)
  source       String
  retrievedAt  DateTime @map("retrieved_at")
  createdAt    DateTime @default(now()) @map("created_at")
  
  @@unique([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

model Goal {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  targetCountryId     String   @map("target_country_id")
  targetCityId        String?  @map("target_city_id")
  targetAmount        Decimal  @map("target_amount") @db.Decimal(15, 2)
  currentAmount       Decimal  @map("current_amount") @db.Decimal(15, 2)
  monthlySavings      Decimal  @map("monthly_savings") @db.Decimal(15, 2)
  estimatedMonths     Int      @map("estimated_months")
  targetDate          DateTime @map("target_date")
  status              String   @default("active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("goals")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  entityId  String   @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, type, entityId])
  @@map("favorites")
}

model Simulation {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  parameters      Json
  results         Json
  createdAt       DateTime @default(now()) @map("created_at")
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("simulations")
}